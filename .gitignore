# Rust
/target

# Nix
.direnv/
result*

# Nix-ninja
out/
# n2's build database, written wherever nix-ninja runs. Committed by
# accident in d0e7960 while running the #4 benchmarks.
.n2_db
# cargo vendoring marker, committed with the vendored n2 tree
.cargo-ok

# Aider
.aider*
vendor/

# python bytecode from scripts/
__pycache__/
*.pyc

# Fork-only working area: notes, staging drafts and dev tooling with no
# upstream value. Anything that IS useful to upstream or other users belongs
# in a tracked path with a ledger entry naming its destination.
/local/

# Fork-only, and they live at the root because that is where their tooling
# looks for them. Untracked, so they never reach upstream.
/CLAUDE.md
/.graphifyignore
